{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/**/*",
    "types/**/*",
    "lib/**/*",
  ],
  "exclude": ["node_modules", "dist", "generated"]
}