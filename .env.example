# PostgreSQL
POSTGRES_USER=change_the_user
POSTGRES_PASSWORD=a_secure_postgres_password
POSTGRES_DB=hellopener

DATABASE_URL="postgresql://change_the_user:a_secure_postgres_password@postgres:5432/hellopener?schema=public"

# pgAdmin (dev uniquement)
PGADMIN_DEFAULT_EMAIL=change_the_user
PGADMIN_DEFAULT_PASSWORD=a_secure_pgadmin_password

PORT=3000

# Utilisé par le docker-compose.yml (dev) — accès direct au backend, navigateur/curl possible
VITE_API_URL_DEV=http://localhost:3000/api

# Utilisé par le docker-compose.prod.yml (build arg) — chemin relatif, passe par Nginx
VITE_API_URL=/api